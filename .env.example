# ------------------------------------------------------------
# Al-Nahda Medical Complex — environment variables example
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ------------------------------------------------------------

# Public site URL — used for canonical tags, OG images, sitemap.
# Set to your Vercel URL in production (e.g. https://alnahdah.sa).
# [PUBLIC]
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sanity project ID — created when you run `npx sanity@latest init --bare`.
# Find it at sanity.io/manage. Safe to expose (client-side reads).
# [PUBLIC]
NEXT_PUBLIC_SANITY_PROJECT_ID=""

# Sanity dataset name. Default convention: "production".
# [PUBLIC]
NEXT_PUBLIC_SANITY_DATASET="production"

# Sanity API version (ISO date). Pin to a date to lock query behavior.
# Optional — code falls back to "2024-12-01".
# [PUBLIC]
NEXT_PUBLIC_SANITY_API_VERSION="2024-12-01"

# Read-only token for server-side draft preview.
# sanity.io/manage → API → Tokens → "Viewer" role.
# Required only if you use Preview / draft mode.
# [SECRET — never commit]
SANITY_API_READ_TOKEN=""

# Shared secret for the /api/revalidate webhook.
# Configure the same value in Sanity → API → Webhooks → Secret.
# Required only if you wire up on-publish revalidation.
# [SECRET — never commit]
SANITY_WEBHOOK_SECRET=""

# Shared secret required to enable draft mode via /api/draft-mode/enable.
# Pick any long random string; pass it as ?secret=… on the enable URL.
# [SECRET — never commit]
SANITY_DRAFT_SECRET=""
